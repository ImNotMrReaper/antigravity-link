[Unit]
Description=Antigravity Link Peer AI Collaboration Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Systemd User Unit for Antigravity Link
# %h expands to the user's home directory
WorkingDirectory=%h/PycharmProjects/antigravity-link
ExecStart=/usr/bin/python3 -u %h/PycharmProjects/antigravity-link/agy_link.py daemon
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
