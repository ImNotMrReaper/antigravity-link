{
  "peer-sync-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/pre_invocation_sync.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
